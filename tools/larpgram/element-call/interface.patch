+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { describe, expect, test } from "vitest";
+
+import { cameraChoices, cameraDeviceLabels } from "./CameraDeviceLabels";
+
+describe("Larpgram camera selection", () => {
+  test("groups sides and identifies wide angle from optics, excluding telephoto", () => {
+    const devices = [
+      camera("0", "back"),
+      camera("1", "front"),
+      camera("2", "back"),
+      camera("3", "back"),
+    ];
+    const labels = cameraDeviceLabels(
+      devices,
+      [
+        { cameraId: "0", side: "rear", relativeFocalLength: 0.7 },
+        { cameraId: "1", side: "front", relativeFocalLength: 0.9 },
+        { cameraId: "2", side: "rear", relativeFocalLength: 0.35 },
+        { cameraId: "3", side: "rear", relativeFocalLength: 1.4 },
+      ],
+      new Map(),
+    );
+    expect([...labels.keys()]).toEqual(["device-1", "device-0", "device-2"]);
+    expect(labels.get("device-2")?.camera).toEqual({
+      side: "rear",
+      lens: "wide",
+    });
+    const choices = cameraChoices(
+      [...labels].map(([id, label]) => ({ id, label })),
+      "device-2",
+    )!;
+    expect(choices.filter((c) => c.checked).map((c) => c.kind)).toEqual([
+      "rear",
+      "wide",
+    ]);
+    expect(new Set(choices.map((c) => c.key)).size).toBe(choices.length);
+  });
+
+  test("does not invent a wide angle mode when capabilities are unknown", () => {
+    const labels = cameraDeviceLabels(
+      [camera("0", "back"), camera("1", "front"), camera("2", "back")],
+      [],
+      new Map(),
+    );
+    expect(
+      [...labels.values()].some((label) => label.camera?.lens === "wide"),
+    ).toBe(false);
+    expect(
+      cameraChoices(
+        [...labels].map(([id, label]) => ({ id, label })),
+        "device-0",
+      ),
+    ).toHaveLength(2);
+  });
+
+  test("keeps named desktop cameras without Android metadata unchanged", () => {
+    const labels = new Map([
+      ["webcam", { type: "name" as const, name: "USB webcam" }],
+    ]);
+    expect(
+      cameraDeviceLabels(
+        [{ deviceId: "webcam", label: "USB webcam" } as MediaDeviceInfo],
+        [],
+        labels,
+      ),
+    ).toBe(labels);
+    expect(
+      cameraChoices(
+        [...labels].map(([id, label]) => ({ id, label })),
+        "webcam",
+      ),
+    ).toBeUndefined();
+  });
+});
+
+function camera(id: string, facing: "front" | "back"): MediaDeviceInfo {
+  return {
+    deviceId: `device-${id}`,
+    label: `camera2 ${id}, facing ${facing}`,
+    kind: "videoinput",
+    groupId: "",
+  } as MediaDeviceInfo;
+}
