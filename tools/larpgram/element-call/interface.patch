+    raisedHandTime: new Date("2026-11-01T10:00:00Z"),
+    showTimer: true,
+    onClick: fn(),
+  },
+} satisfies Meta<typeof RaisedHandIndicator>;
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Raised: Story = {
+  play: async ({ canvasElement, args }) => {
+    const canvas = within(canvasElement);
+    await expect(canvasElement.querySelector("p")).toBeNull();
+    await userEvent.click(canvas.getByRole("button", { name: "Lower hand" }));
+    await expect(args.onClick).toHaveBeenCalled();
+  },
+};
+export const Miniature: Story = { args: { miniature: true } };
