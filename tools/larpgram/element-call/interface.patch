@@ -0,0 +1,45 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { expect, test } from "@playwright/test";
+
+// The local component harness needs no Synapse and never places a real call.
+const storybook = process.env.LARPGRAM_STORYBOOK_URL;
+test.skip(
+  !storybook,
+  "Set LARPGRAM_STORYBOOK_URL to the local Storybook server",
+);
+
+test("camera side and wide angle controls work without technical device names", async ({
+  page,
+}) => {
+  await page.goto(
+    `${storybook}/iframe.html?id=larpgram-camera-selection--mobile&viewMode=story`,
+  );
+  await expect(page.getByLabel("Rear camera")).toBeChecked();
+  await page.getByLabel("Wide angle").check();
+  await expect(page.getByLabel("Wide angle")).toBeChecked();
+  await expect(page.getByLabel("Rear camera")).toBeChecked();
+  await page.getByLabel("Front camera").check();
+  await expect(page.getByLabel("Wide angle")).toHaveCount(0);
+  await page.getByLabel("Rear camera").check();
+  await expect(page.getByLabel("Standard")).toBeChecked();
+  await expect(page.getByText(/camera2/)).toHaveCount(0);
+});
+
+test("raised hand has an accessible action and no elapsed time", async ({
+  page,
+}) => {
+  await page.goto(
+    `${storybook}/iframe.html?id=larpgram-raised-hand--miniature&viewMode=story`,
+  );
+  await expect(page.getByRole("button", { name: "Lower hand" })).toBeVisible();
+  await expect(
+    page.getByRole("button", { name: "Lower hand" }).locator("p"),
+  ).toHaveCount(0);
+  await page.getByRole("button", { name: "Lower hand" }).click();
+});
