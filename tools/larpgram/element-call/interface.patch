+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { expect, test, vi } from "vitest";
+
+const bootstrap = vi.hoisted(() => ({
+  ready: false,
+  render: vi.fn(),
+  options: vi.fn(),
+  metadata: [{ cameraId: "0", side: "rear", relativeFocalLength: 0.6 }],
+}));
+vi.mock("react-dom/client", () => ({
+  createRoot: () => ({ render: bootstrap.render }),
+}));
+vi.mock("./index.css", () => ({}));
+vi.mock("./App", () => ({ App: () => null }));
+vi.mock("./settings/rageshake", () => ({
+  init: async () => {
+    await Promise.resolve();
+  },
+}));
+vi.mock("./initializer", () => ({
+  Initializer: {
+    initBeforeReact: async () => {
+      await Promise.resolve();
+    },
+  },
+}));
+vi.mock("./config/Config", () => ({
+  Config: {
+    init: async () => {
+      await Promise.resolve();
+      bootstrap.ready = true;
+    },
+    get: () => {
+      if (!bootstrap.ready)
+        throw new Error("Config read before initialization");
+      return { larpgram_camera_metadata: bootstrap.metadata };
+    },
+  },
+}));
+vi.mock("./state/AppViewModel", () => ({
+  AppViewModel: class {
+    constructor(_scope: unknown, options: unknown) {
+      bootstrap.options(options);
+    }
+  },
+}));
+
+test("cold embedded startup loads config before constructing camera options", async () => {
+  vi.stubGlobal("isSecureContext", true);
+  vi.stubGlobal("navigator", {
+    mediaDevices: {},
+    userAgent: navigator.userAgent,
+  });
+  try {
+    await import("./main");
+    await vi.waitFor(() =>
+      expect(bootstrap.options).toHaveBeenCalledWith(
+        expect.objectContaining({ cameraMetadata: bootstrap.metadata }),
+      ),
+    );
+    expect(bootstrap.render).toHaveBeenCalledOnce();
+  } finally {
+    vi.unstubAllGlobals();
+  }
+});
