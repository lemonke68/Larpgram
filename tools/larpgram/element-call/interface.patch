+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { type TFunction } from "i18next";
+
+import { type DeviceLabel } from "./MediaDevices";
+
+export interface CameraMetadata {
+  cameraId: string;
+  side: "front" | "rear";
+  relativeFocalLength: number;
+}
+
+export type CameraKind = "front" | "rear" | "standard" | "wide";
+export interface CameraChoice {
+  key: string;
+  id: string;
+  kind: CameraKind;
+  checked: boolean;
+}
+
+/** Larpgram: physical lenses become a side and a supported lens mode, not numbered cameras. */
+export function cameraDeviceLabels(
+  devices: MediaDeviceInfo[],
+  metadata: CameraMetadata[],
+  fallback: Map<string, DeviceLabel>,
+): Map<string, DeviceLabel> {
+  const result = new Map<string, DeviceLabel>();
+  for (const side of ["front", "rear"] as const) {
+    const candidates = devices.flatMap((device) => {
+      const match = /^camera2?\s+([^\s,]+).*facing\s+(front|back)/i.exec(
+        device.label,
+      );
+      if (!match) return [];
+      const info = metadata.find((m) => m.cameraId === match[1]);
+      const deviceSide =
+        info?.side ?? (match[2] === "front" ? "front" : "rear");
+      return deviceSide === side ? [{ device, info }] : [];
+    });
+    const standard = candidates[0];
+    if (!standard) continue;
+    result.set(standard.device.deviceId, {
+      type: "name",
+      name: standard.device.label,
+      camera: { side, lens: "standard" },
+    });
+    const focal = standard.info?.relativeFocalLength;
+    if (focal === undefined || focal <= 0) continue;
+    const wide = candidates
+      .filter(
+        (candidate) =>
+          candidate.info &&
+          candidate.info.relativeFocalLength > 0 &&
+          candidate.info.relativeFocalLength < focal * 0.85,
+      )
+      .sort(
+        (a, b) => a.info!.relativeFocalLength - b.info!.relativeFocalLength,
+      )[0];
+    if (wide) {
+      result.set(wide.device.deviceId, {
+        type: "name",
+        name: wide.device.label,
+        camera: { side, lens: "wide" },
+      });
+    }
+  }
+  return result.size > 0 ? result : fallback;
+}
+
+export function cameraChoices(
+  devices: { id: string; label: DeviceLabel }[],
+  selectedId: string | undefined,
+): CameraChoice[] | undefined {
+  if (!devices.some((d) => d.label.camera)) return undefined;
+  const current = devices.find((d) => d.id === selectedId)?.label.camera;
+  const choices: CameraChoice[] = [];
+  for (const side of ["front", "rear"] as const) {
+    const standard = devices.find(
+      (d) =>
+        d.label.camera?.side === side && d.label.camera.lens === "standard",
+    );
+    if (standard)
+      choices.push({
+        key: side,
+        id: standard.id,
+        kind: side,
+        checked: current?.side === side,
+      });
+  }
+  const lenses = devices.filter((d) => d.label.camera?.side === current?.side);
+  if (lenses.some((d) => d.label.camera?.lens === "wide")) {
+    for (const device of lenses) {
+      const lens = device.label.camera!.lens;
+      choices.push({
+        key: lens,
+        id: device.id,
+        kind: lens,
+        checked: device.id === selectedId,
+      });
+    }
+  }
+  return choices;
+}
+
+export function cameraChoiceLabel(t: TFunction, kind: CameraKind): string {
+  switch (kind) {
+    case "front":
+      return t("settings.devices.front_camera");
+    case "rear":
+      return t("settings.devices.rear_camera");
+    case "standard":
+      return t("settings.devices.standard_lens");
+    case "wide":
+      return t("settings.devices.wide_lens");
+  }
+}
