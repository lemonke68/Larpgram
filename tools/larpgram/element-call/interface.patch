+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { type Meta, type StoryObj } from "@storybook/react-vite";
+import { expect, userEvent, within } from "storybook/test";
+import { useMemo } from "react";
+import { BehaviorSubject } from "rxjs";
+
+import { Root as Form } from "@vector-im/compound-web";
+import { DeviceSelection } from "./DeviceSelection";
+import { constant } from "../state/Behavior";
+import { type DeviceLabel } from "../state/MediaDevices";
+
+const meta = {
+  title: "Larpgram/Camera selection",
+  component: CameraSelectionStory,
+  args: { wideAngle: true },
+} satisfies Meta<typeof CameraSelectionStory>;
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const NormalAndWide: Story = {
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    await expect(canvas.getByLabelText("Rear camera")).toBeChecked();
+    await userEvent.click(canvas.getByLabelText("Wide angle"));
+    await expect(canvas.getByLabelText("Wide angle")).toBeChecked();
+    await expect(canvas.getByLabelText("Rear camera")).toBeChecked();
+    await userEvent.click(canvas.getByLabelText("Front camera"));
+    await expect(canvas.getByLabelText("Front camera")).toBeChecked();
+    await expect(canvas.queryByLabelText("Wide angle")).not.toBeInTheDocument();
+  },
+};
+export const NoWideLens: Story = { args: { wideAngle: false } };
+export const Mobile: Story = { globals: { viewport: { value: "mobile2" } } };
+
+function CameraSelectionStory({ wideAngle }: { wideAngle: boolean }) {
+  const device = useMemo(() => {
+    const selected = new BehaviorSubject({ id: "rear" });
+    const labels = new Map<string, DeviceLabel>([
+      [
+        "front",
+        {
+          type: "name",
+          name: "camera2 1, facing front",
+          camera: { side: "front", lens: "standard" },
+        },
+      ],
+      [
+        "rear",
+        {
+          type: "name",
+          name: "camera2 0, facing back",
+          camera: { side: "rear", lens: "standard" },
+        },
+      ],
+    ]);
+    if (wideAngle)
+      labels.set("wide", {
+        type: "name",
+        name: "camera2 2, facing back",
+        camera: { side: "rear", lens: "wide" },
+      });
+    return {
+      available$: constant(labels),
+      selected$: selected,
+      select: (id: string) => selected.next({ id }),
+    };
+  }, [wideAngle]);
+  return (
+    <Form>
+      <DeviceSelection
+        device={device}
+        title="Camera"
+        numberedLabel={(n) => `Camera ${n}`}
+      />
+    </Form>
+  );
+}
