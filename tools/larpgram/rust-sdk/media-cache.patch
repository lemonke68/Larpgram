+// Larpgram: classify only recognized content before store encryption. Unknown formats,
+// ambiguous containers and legacy rows are deliberately reported as Other.
+fn media_kind(request: &MediaRequestParameters, data: &[u8]) -> i64 {
+    if matches!(request.format, MediaFormat::Thumbnail(_)) {
+        return 4;
+    }
+    match infer::get(data).map(|kind| kind.mime_type()) {
+        Some(mime) if mime.starts_with("image/") => 1,
+        Some("video/mp4" | "video/webm" | "audio/ogg") => 0,
+        Some(mime) if mime.starts_with("video/") => 2,
+        Some(mime) if mime.starts_with("audio/") => 3,
+        _ => 0,
+    }
+}
