+            .set_ignore_media_retention_policy(&pending, IgnoreMediaRetentionPolicy::No)
+            .await
+            .unwrap();
+        store.replace_media_key(&pending, &remote).await.unwrap();
+        store
+            .set_ignore_media_retention_policy(&thumb, IgnoreMediaRetentionPolicy::No)
+            .await
+            .unwrap();
+        store.replace_media_key(&thumb, &remote_thumb).await.unwrap();
+        store.set_media_content_type(&remote_thumb, "image/jpeg").await.unwrap();
+        let usage = store.media_cache_usage().await.unwrap().unwrap();
+        assert!(usage.videos > 0);
+        assert!(usage.thumbnails > 0);
+        assert_eq!(usage.images + usage.audio + usage.other + usage.protected, 0);
+        store.set_media_content_type(&remote, "audio/ogg").await.unwrap();
+        let usage = store.media_cache_usage().await.unwrap().unwrap();
+        assert!(usage.audio > 0);
+        assert_eq!(usage.videos, 0);
+    }
 }
