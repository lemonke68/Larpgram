<resources>
    <!-- Тип сообщения в списке чатов и в уведомлении: кружочек, круглое видеосообщение. -->
    <string name="larpgram_video_message">"Video message"</string>
    <!-- Кнопка на своём профиле (TG-стиль): выбрать/сменить фото аватара. -->
    <string name="larpgram_action_set_photo">"Set photo"</string>
    <!-- Кнопка на своём профиле: изменить профиль. Короткое слово, как в TG: «Редактировать» не
         влезало в плитку и переносилось по слогам. -->
    <string name="larpgram_action_edit_profile">"Edit"</string>
    <!-- Подпись строки описания (bio) в карточке профиля. Не путать с common_about («О приложении»). -->
    <string name="larpgram_profile_about_label">"About"</string>

    <!-- Присутствие пользователя (шапка чата, профили): «в сети», «был(а) …». -->
    <string name="larpgram_presence_online">online</string>
    <string name="larpgram_presence_last_seen_recently">last seen recently</string>
    <string name="larpgram_presence_last_seen_just_now">last seen just now</string>
    <plurals name="larpgram_presence_last_seen_minutes">
        <item quantity="one">last seen %1$d minute ago</item>
        <item quantity="other">last seen %1$d minutes ago</item>
    </plurals>
    <string name="larpgram_presence_last_seen_at">last seen at %1$s</string>
    <string name="larpgram_presence_last_seen_yesterday">last seen yesterday at %1$s</string>
    <string name="larpgram_presence_last_seen_date">last seen %1$s</string>
</resources>
