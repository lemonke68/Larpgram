<?xml version="1.0" encoding="utf-8"?>
<!--
  Модуль форка: установка обновления из приложения.

  SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Ответы PackageInstaller по сессии установки обновления. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />

        <!-- После самообновления открыть приложение снова. -->
        <receiver
            android:name=".UpdateAppliedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
