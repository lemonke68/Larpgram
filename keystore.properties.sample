# Правка форка: шаблон секретов релизной подписи Larpgram.
#
# Скопируй в keystore.properties (он в .gitignore, в репозиторий не попадёт) и заполни
# своими значениями. keystore создаётся один раз командой из README/handoff, пароль
# знаешь только ты. Потеря keystore или пароля = невозможность обновлять приложение у
# людей, поэтому храни копию в надёжном месте (менеджер паролей, оффлайн-бэкап).
#
# storeFile — путь относительно корня проекта. По умолчанию app/signature/larpgram.keystore.

storeFile=app/signature/larpgram.keystore
storePassword=ЗАМЕНИ_НА_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=larpgram
keyPassword=ЗАМЕНИ_НА_ПАРОЛЬ_КЛЮЧА
