<?xml version="1.0" encoding="utf-8"?>
<!-- Larpgram fork strings. Kept out of localazy.xml so the translation pipeline does not overwrite them. -->
<resources>
    <!-- Comments button shown under each channel post; opens the linked discussion thread. -->
    <string name="screen_channel_comments">Comments</string>
    <!-- Channel subscriber bar (shown instead of the composer): tap to mute notifications. -->
    <string name="screen_channel_mute">Mute</string>
    <!-- Channel subscriber bar: tap to unmute notifications. -->
    <string name="screen_channel_unmute">Unmute</string>
    <!-- Subscriber count shown under a channel name in its header. -->
    <plurals name="channel_subscriber_count">
        <item quantity="one">%1$d subscriber</item>
        <item quantity="other">%1$d subscribers</item>
    </plurals>
    <!-- Roomless: shown instead of the composer for a blocked DM peer; tap to unblock. -->
    <string name="screen_room_unblock_user">You blocked this user. Tap to unblock.</string>
    <!-- Roomless (gap D): comment count on a channel post's Comments chip. -->
    <plurals name="channel_comments_count">
        <item quantity="one">%1$d comment</item>
        <item quantity="other">%1$d comments</item>
    </plurals>
    <!-- Telegram chat header subtitle (TgChatHeader). -->
    <string name="larpgram_header_typing">typing…</string>
    <string name="larpgram_header_typing_one">%1$s is typing…</string>
    <string name="larpgram_header_typing_two">%1$s and %2$s are typing…</string>
    <plurals name="larpgram_header_typing_many">
        <item quantity="one">%1$d person is typing…</item>
        <item quantity="other">%1$d people are typing…</item>
    </plurals>
    <plurals name="larpgram_header_members">
        <item quantity="one">%1$d member</item>
        <item quantity="other">%1$d members</item>
    </plurals>
    <string name="larpgram_header_menu_video_call">Video call</string>
    <string name="larpgram_header_menu_mute">Mute</string>
    <string name="larpgram_header_menu_unmute">Unmute</string>
    <string name="larpgram_header_menu_threads">Threads</string>
    <string name="larpgram_header_menu_info">Info</string>
    <string name="larpgram_pinned_message_title">Pinned message</string>
    <!-- Меню вложений Telegram -->
    <string name="larpgram_attach_tab_gallery">Gallery</string>
    <string name="larpgram_attach_tab_file">File</string>
    <string name="larpgram_attach_tab_location">Location</string>
    <string name="larpgram_attach_tab_poll">Poll</string>
    <string name="larpgram_attach_tab_format">Format</string>
    <string name="larpgram_attach_caption_hint">Add a caption…</string>
    <plurals name="larpgram_attach_selected_photos">
        <item quantity="one">%1$d photo selected</item>
        <item quantity="other">%1$d photos selected</item>
    </plurals>
    <plurals name="larpgram_attach_selected_videos">
        <item quantity="one">%1$d video selected</item>
        <item quantity="other">%1$d videos selected</item>
    </plurals>
    <plurals name="larpgram_attach_selected_media">
        <item quantity="one">%1$d file selected</item>
        <item quantity="other">%1$d files selected</item>
    </plurals>
    <string name="larpgram_attach_send_uncompressed">Send without compression</string>
    <string name="larpgram_attach_access_title">Access to photos and videos</string>
    <string name="larpgram_attach_access_text">Allow access to your gallery to pick photos and videos right here.</string>
    <string name="larpgram_attach_access_allow">Allow access</string>
    <string name="larpgram_attach_access_settings">Open settings</string>
    <string name="larpgram_attach_system_gallery">System gallery</string>
    <string name="larpgram_attach_partial_access">Only some photos and videos are shared.</string>
    <string name="larpgram_attach_partial_manage">Change</string>
    <string name="larpgram_attach_camera">Camera. Tap for a photo, hold for a video</string>
</resources>
