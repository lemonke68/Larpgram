# --- Секреты (обязательные) ---
# Пеппер для хэша кодов. Любая случайная строка:
#   openssl rand -hex 32
CODE_PEPPER=

# --- MAS ---
# Адрес MAS в докер-сети, вместе с префиксом пути (у нас MAS живёт под /auth).
MAS_URL=http://matrix-authentication-service:8080/auth
# Клиент admin API: тот же id и секрет, что в vars.yml плейбука
# (matrix_authentication_service_config_clients_custom + policy.data.admin_clients).
MAS_CLIENT_ID=
MAS_CLIENT_SECRET=

# --- Matrix ---
# Куда ходить за whoami (проверка токена вошедшего устройства при привязке по QR).
HOMESERVER_URL=https://matrix.mango-kokos.ru

# --- Почта (через matrix-exim-relay, тот же релей, что у MAS) ---
SMTP_HOST=matrix-exim-relay
SMTP_PORT=8025
MAIL_FROM=Larpgram <noreply@mango-kokos.ru>

# --- Прочее (можно не трогать) ---
PORT=8080
DB_PATH=/data/account.db
CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=60
MAX_ATTEMPTS=5
