# --- Секреты (обязательные) ---
# Мастер-ключ шифрования ключей в БД. Ровно 32 байта в base64:
#   openssl rand -base64 32
ESCROW_MASTER_KEY=
# Пеппер для хэша кодов. Любая случайная строка:
#   openssl rand -hex 32
CODE_PEPPER=

# --- Matrix ---
# Куда ходить за whoami и /account/3pid (Synapse).
HOMESERVER_URL=https://matrix.mango-kokos.ru
# Admin-токен Synapse для «удалить у обоих» (POST /room/delete). Пусто — эндпоинт вернёт 503.
# Выпуск (без флага выйдет токен без admin-scope, 403):
# токен бота @escrow-admin, не личный (подробно — DEPLOY.md, «Удалить у обоих»):
#   docker exec matrix-authentication-service mas-cli manage issue-compatibility-token \
#     --yes-i-want-to-grant-synapse-admin-privileges escrow-admin ESCROWADMIN
SYNAPSE_ADMIN_TOKEN=

# --- Почта (через matrix-exim-relay, тот же релей, что у MAS) ---
SMTP_HOST=matrix-exim-relay
SMTP_PORT=8025
MAIL_FROM=Larpgram <no-reply@mango-kokos.ru>

# --- Прочее (можно не трогать) ---
PORT=8080
DB_PATH=/data/escrow.db
CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=60
MAX_ATTEMPTS=5
