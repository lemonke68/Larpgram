<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка форка: фиолетовый градиент по диагонали (фирменный акцент приложения).
  Полный залив 512x512, скругление даёт маска лаунчера, поэтому тут углы прямые.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="512"
                android:endY="512">
                <item android:offset="0" android:color="#FFA78BFF" />
                <item android:offset="0.55" android:color="#FF7C4DFF" />
                <item android:offset="1" android:color="#FF5E33E0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
